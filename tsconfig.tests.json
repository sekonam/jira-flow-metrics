{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "apps/*/test/**/*.ts",
    "apps/*/test/**/*.tsx",
    "packages/ui-harness/harness/**/*.ts",
    "packages/ui-harness/harness/**/*.tsx",
    "test/**/*.ts",
    "*.config.mts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
