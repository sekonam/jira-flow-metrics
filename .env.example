# Credentials for `pnpm run seed:dev-site`, which seeds a free Jira Cloud
# developer site with the issue history the first tunnel session needs.
#
# Copy to `.env` and fill in. `.env` is git-ignored; the token is a credential
# and must never be committed.

# The developer site, e.g. https://your-site.atlassian.net
JIRA_BASE_URL=

# The Atlassian account email the site belongs to.
JIRA_EMAIL=

# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
# A plain API token is enough; this needs no scopes beyond the account's own
# permissions on its own developer site.
JIRA_API_TOKEN=
