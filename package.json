{
  "name": "jira-flow-metrics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared duration-analytics engine over Jira changelogs and worklogs, published as five Atlassian Marketplace listings.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --build --verbose && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "ui:screens": "node packages/ui-harness/scripts/build-scenarios.mjs && node packages/ui-harness/scripts/screens.mjs",
    "verify": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run preflight && pnpm run coverage && pnpm run build",
    "seed:dev-site": "node tools/seed-dev-site.mjs",
    "seed:bulk": "node tools/seed-bulk.mjs",
    "e2e:live": "node packages/ui-harness/scripts/live-e2e.mjs",
    "e2e:ui": "node packages/ui-harness/scripts/build-scenarios.mjs && node packages/ui-harness/scripts/e2e-ui.mjs",
    "preflight": "node tools/preflight.mjs",
    "backfill:scale": "node packages/ui-harness/scripts/scale-backfill.mjs",
    "thumbnails": "node packages/ui-harness/scripts/render-thumbnails.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@jfm/engine": "workspace:^",
    "@jfm/forge-runtime": "workspace:^",
    "@jfm/ui-harness": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.1.14"
    }
  }
}
