{
  "name": "jira-flow-metrics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared duration-analytics engine over Jira changelogs and worklogs, published as five Atlassian Marketplace listings.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --build --verbose && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run coverage && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@jfm/engine": "workspace:^",
    "@jfm/ui-harness": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.1.14"
    }
  }
}
